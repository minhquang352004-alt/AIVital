{
  "$defs": {
    "BloodPressureUse": {
      "enum": [
        "research_only",
        "wellness_estimate"
      ],
      "title": "BloodPressureUse",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "WARNING",
        "ERROR"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "ResultStatus": {
      "enum": [
        "OK",
        "BAD",
        "INVALID"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sbp_mmhg": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sbp Mmhg"
    },
    "dbp_mmhg": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dbp Mmhg"
    },
    "unit": {
      "const": "mmHg",
      "default": "mmHg",
      "title": "Unit",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "status": {
      "$ref": "#/$defs/ResultStatus"
    },
    "intended_use": {
      "$ref": "#/$defs/BloodPressureUse"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "feature_set_version": {
      "title": "Feature Set Version",
      "type": "string"
    },
    "missing_features": {
      "items": {
        "type": "string"
      },
      "title": "Missing Features",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "sbp_mmhg",
    "dbp_mmhg",
    "confidence",
    "status",
    "intended_use",
    "model",
    "feature_set_version"
  ],
  "title": "BloodPressureEstimate",
  "type": "object"
}
