{
  "$defs": {
    "EvidenceLevel": {
      "enum": [
        "established",
        "promising",
        "insufficient",
        "not_recommended"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "WARNING",
        "ERROR"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "ResultStatus": {
      "enum": [
        "OK",
        "BAD",
        "INVALID"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "RiskCategory": {
      "enum": [
        "low",
        "moderate",
        "elevated"
      ],
      "title": "RiskCategory",
      "type": "string"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "risk_code": {
      "minLength": 1,
      "title": "Risk Code",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "category": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskCategory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/ResultStatus"
    },
    "evidence_level": {
      "$ref": "#/$defs/EvidenceLevel"
    },
    "intended_use": {
      "const": "research_only",
      "default": "research_only",
      "title": "Intended Use",
      "type": "string"
    },
    "is_diagnosis": {
      "const": false,
      "default": false,
      "title": "Is Diagnosis",
      "type": "boolean"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "source_result_id": {
      "title": "Source Result Id",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "risk_code",
    "status",
    "evidence_level",
    "model",
    "source_result_id"
  ],
  "title": "HealthRiskOutput",
  "type": "object"
}
