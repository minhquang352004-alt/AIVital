# ==========================================
# AIVitals Project .gitignore
# ==========================================

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Python Byte-compiled / Cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Python Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# External Reference Repositories (Heavy source, 700MB+)
rPPG-Toolbox/

# Datasets & Large Data Files
data/
datasets/
*.mat
*.h5
*.hdf5

# Heavy Model Weights / Checkpoints (Exported or downloaded)
*.pth
*.pt
*.onnx
*.tflite
*.weights
*.bin

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Temporary / Log / Backup files
*.log
*.tmp
*.bak
*~
*.sw[p-z]
.*.sw[p-z]
*.swo
*.kate-swp
.*.kate-swp

# Documents & Office Lock files
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.pdf
.~lock.*
notes/
scratch/

# IDE & Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Generated Files
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db

# Test Outputs & Ad-hoc Videos
/outputs/
aivitals_engine/outputs/*
!aivitals_engine/outputs/.gitkeep
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Keep only light sample files in Repository
!aivitals_engine/samples/*.csv
!aivitals_engine/samples/sample_video.mp4

# Exclude heavy videos in samples
aivitals_engine/samples/*.avi
aivitals_engine/samples/vid.avi
